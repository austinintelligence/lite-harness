            "minLength": 1,
            "maxLength": 128,
            "pattern": ".*\\S.*",
            "type": "string"
          },
          "instructions": {
            "maxLength": 1000000,
            "type": "string"
          },
          "modelCapabilities": {
            "maxItems": 6,
            "uniqueItems": true,
            "type": "array",
            "items": {
