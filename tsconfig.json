{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@lite-harness/contracts": ["packages/contracts/src/index.ts"],
      "@lite-harness/config": ["packages/config/src/index.ts"],
      "@lite-harness/auth": ["packages/auth/src/index.ts"],
      "@lite-harness/auth-sqlite": ["packages/auth-sqlite/src/index.ts"],
      "@lite-harness/domain": ["packages/domain/src/index.ts"],
      "@lite-harness/storage-sqlite": ["packages/storage-sqlite/src/index.ts"],
      "@lite-harness/agent-runtime": ["packages/agent-runtime/src/index.ts"],
      "@lite-harness/runtime": ["packages/runtime/src/index.ts"],
      "@lite-harness/runtime-docker": ["packages/runtime-docker/src/index.ts"],
      "@lite-harness/control-plane": ["packages/control-plane/src/index.ts"],
      "@lite-harness/sdk": ["packages/sdk-typescript/src/index.ts"]
      ,"@lite-harness/provider-core": ["packages/provider-core/src/index.ts"]
      ,"@lite-harness/provider-openai-compatible": ["packages/provider-openai-compatible/src/index.ts"]
      ,"@lite-harness/provider-anthropic": ["packages/provider-anthropic/src/index.ts"]
      ,"@lite-harness/workspace": ["packages/workspace/src/index.ts"]
      ,"@lite-harness/plugin-core": ["packages/plugin-core/src/index.ts"]
      ,"@lite-harness/skills": ["packages/skills/src/index.ts"]
      ,"@lite-harness/mcp": ["packages/mcp/src/index.ts"]
      ,"@lite-harness/context": ["packages/context/src/index.ts"]
      ,"@lite-harness/browser": ["packages/browser/src/index.ts"]
      ,"@lite-harness/integrations": ["packages/integrations/src/index.ts"]
      ,"@lite-harness/automation": ["packages/automation/src/index.ts"]
      ,"@lite-harness/subagents": ["packages/subagents/src/index.ts"]
      ,"@lite-harness/memory-sqlite": ["packages/memory-sqlite/src/index.ts"]
      ,"@lite-harness/process-rpc": ["packages/process-rpc/src/index.ts"]
      ,"@lite-harness/delegated-runtime": ["packages/delegated-runtime/src/index.ts"]
      ,"@lite-harness/credential-store": ["packages/credential-store/src/index.ts"]
      ,"@lite-harness/operations": ["packages/operations/src/index.ts"]
      ,"@lite-harness/migration-openclaw": ["packages/migration-openclaw/src/index.ts"]
    }
  },
  "include": ["apps/**/*.ts", "packages/**/*.ts", "test/**/*.ts", "vitest.config.ts"]
}
