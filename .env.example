LITE_HARNESS_INTERNAL_TOKEN=replace-with-a-random-256-bit-value
LITE_HARNESS_APP_TOKEN=replace-with-a-different-random-256-bit-value
LITE_HARNESS_MODE=development
LITE_HARNESS_RUNTIME=fake
LITE_HARNESS_PROVIDER=fake
LITE_HARNESS_DATA_DIR=.lite-harness
LITE_HARNESS_HOST=127.0.0.1
LITE_HARNESS_PORT=3210

# Optional tool-approval policy. Route generation is derived from the provider,
# model, and sanitized base URL unless an operator-managed generation is set.
LITE_HARNESS_REQUIRE_APPROVALS=false
LITE_HARNESS_APPROVAL_TIMEOUT_MS=60000
# LITE_HARNESS_ROUTE_GENERATION=route-policy-v1

# Optional features use exact lowercase booleans; invalid spellings fail closed.
# LITE_HARNESS_ENABLE_MEMORY=false
# LITE_HARNESS_WORKSPACE_COLD_AFTER_CHECKPOINT=false
# LITE_HARNESS_BROWSER_ALLOW_PRIVATE=false
# LITE_HARNESS_CONTEXT_OPTIMIZATION=false
# LITE_HARNESS_ENABLE_PLUGINS=false
# LITE_HARNESS_ENABLE_CACHE_CATALOG=false
# Fail-closed offline mode permits the fake provider in development or an
# openai-compatible provider on loopback. It rejects browser/callback egress
# and remote HTTP MCP; Docker runtime launches never pull missing images.
# LITE_HARNESS_OFFLINE=false

# Direct-provider runs have a hard dollar ceiling, so both price rates must be
# supplied for the selected model. Use 0 only for a genuinely zero-marginal-cost
# local/subscription proxy; unknown pricing fails closed before provider I/O.
# LITE_HARNESS_MODEL_INPUT_USD_PER_MILLION=1.25
# LITE_HARNESS_MODEL_OUTPUT_USD_PER_MILLION=10

# Required only when LITE_HARNESS_RUNTIME=docker. Production runtime images
# must be pinned by digest, not a mutable tag.
# LITE_HARNESS_RUNTIME_IMAGE=registry.example/lite-tool-runtime@sha256:...
