          "workspace": {
            "minLength": 1,
            "maxLength": 128,
            "type": "string"
          },
          "session": {
            "minLength": 1,
            "maxLength": 128,
            "type": "string"
          },
          "input": {
            "minLength": 1,
            "maxLength": 1000000,
            "type": "string"
          },
          "budget": {
            "additionalProperties": false,
            "type": "object",
            "properties": {
              "maxTurns": {
                "minimum": 1,
                "maximum": 128,
                "type": "integer"
              },
              "maxToolCalls": {
                "minimum": 0,
                "maximum": 10000,
                "type": "integer"
              },
              "maxInputTokens": {
                "minimum": 1,
                "type": "integer"
              },
              "maxOutputTokens": {
                "minimum": 1,
                "type": "integer"
              },
              "maxCostUsd": {
                "minimum": 0,
                "type": "number"
              },
              "totalTimeoutMs": {
                "minimum": 100,
                "maximum": 86400000,
                "type": "integer"
              },
              "modelIdleTimeoutMs": {
                "minimum": 100,
                "maximum": 3600000,
                "type": "integer"
              },
              "commandTimeoutMs": {
                "minimum": 100,
                "maximum": 3600000,
                "type": "integer"
              }
            }
          }
        },
        "required": [
          "agent",
          "workspace",
          "input"
        ]
      },
      "RunBudgetOverrides": {
        "additionalProperties": false,
        "type": "object",
        "properties": {
          "maxTurns": {
            "minimum": 1,
            "maximum": 128,
            "type": "integer"
          },
          "maxToolCalls": {
            "minimum": 0,
            "maximum": 10000,
            "type": "integer"
          },
          "maxInputTokens": {
            "minimum": 1,
            "type": "integer"
          },
          "maxOutputTokens": {
            "minimum": 1,
            "type": "integer"
          },
          "maxCostUsd": {
            "minimum": 0,
            "type": "number"
          },
          "totalTimeoutMs": {
            "minimum": 100,
            "maximum": 86400000,
            "type": "integer"
          },
          "modelIdleTimeoutMs": {
            "minimum": 100,
            "maximum": 3600000,
            "type": "integer"
          },
          "commandTimeoutMs": {
            "minimum": 100,
            "maximum": 3600000,
            "type": "integer"
          }
