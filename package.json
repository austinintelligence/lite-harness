{
  "name": "lite-harness-workspace",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "A local-first, application-embeddable agent harness transformed from OpenClaw behind a small Lite-owned kernel.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drperky20/lite-harness.git"
  },
  "bugs": {
    "url": "https://github.com/drperky20/lite-harness/issues"
  },
  "homepage": "https://github.com/drperky20/lite-harness#readme",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:python": "python -m build --outdir dist/python sdks/python",
    "build:all": "pnpm build && pnpm build:python",
    "check:artifacts": "node scripts/check-built-artifacts.mjs",
    "typecheck": "tsc --noEmit",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:repository": "node scripts/check-repository.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:provenance": "node scripts/check-provenance.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check:images": "node scripts/check-image-workflow.mjs",
    "check:workflows": "node scripts/check-workflows.mjs",
    "check:doctor": "node scripts/check-doctor.mjs",
    "check:observability": "node scripts/check-observability.mjs",
    "check:status-truth": "node scripts/check-status-truth.mjs",
    "check:pxpipe-evidence": "node scripts/check-paired-context-evidence.mjs",
    "generate:requirements": "node scripts/generate-requirements.mjs",
    "check:requirements:structure": "node scripts/check-requirements.mjs --structure",
    "check:requirements": "node scripts/check-requirements.mjs",
    "check:requirements:verified": "node scripts/check-requirements.mjs --verified-only",
    "generate:defects": "node scripts/generate-defect-ledger.mjs",
    "reproduce:defects:critical": "node scripts/record-defect-reproductions.mjs critical",
    "reproduce:defects:high": "node scripts/record-defect-reproductions.mjs high",
    "check:defects:structure": "node scripts/check-defects.mjs --structure",
    "check:defects": "node scripts/check-defects.mjs",
    "check:defects:closed": "node scripts/check-defects.mjs --closed-only",
    "evidence:collect": "node scripts/collect-release-evidence.mjs",
    "evidence:external": "node scripts/evidence-external.mjs",
    "evidence:provider": "tsx scripts/evidence-provider.ts",
    "generate:status": "node scripts/generate-status.mjs",
    "check:status": "node scripts/generate-status.mjs --check",
    "generate:blockers": "node scripts/generate-blockers.mjs",
    "check:blockers": "node scripts/generate-blockers.mjs --check",
    "assemble:ci-evidence": "node scripts/assemble-ci-evidence.mjs",
    "aggregate:evidence": "node scripts/aggregate-ci-evidence.mjs",
    "reconcile:truth": "node scripts/reconcile-release-truth.mjs",
    "generate:adrs:frozen": "node scripts/generate-frozen-adrs.mjs",
    "check:adrs:frozen": "node scripts/generate-frozen-adrs.mjs --check",
    "generate:adrs:research": "node scripts/generate-research-adrs.mjs",
    "check:adrs:research": "node scripts/generate-research-adrs.mjs --check",
    "check:schemas": "node scripts/check-schemas.mjs",
    "check:evidence": "node scripts/check-schemas.mjs --referenced-evidence",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "check:openapi": "tsx scripts/generate-openapi.ts --check",
    "verify": "pnpm typecheck && pnpm check:boundaries && pnpm check:repository && pnpm test && pnpm check:truth-structure",
    "check": "pnpm verify",
    "check:truth-structure": "pnpm check:schemas && pnpm check:openapi && pnpm check:requirements:structure && pnpm check:defects:structure && pnpm check:adrs:frozen && pnpm check:adrs:research && pnpm check:status && pnpm check:blockers",
    "release:check": "pnpm verify && pnpm build:all && pnpm check:secrets && pnpm check:provenance && pnpm check:release && pnpm check:requirements && pnpm check:defects",
    "generate:sbom": "node scripts/generate-sbom.mjs",
    "evaluate:pxpipe": "tsx scripts/evaluate-context.ts",
    "evaluate:pxpipe:hermes": "node scripts/with-hermes-model.mjs node --import tsx scripts/evaluate-context.ts --paired-hermes --evidence docs/pxpipe-paired-evaluation.json",
    "evaluate:hermes:docker": "node scripts/with-hermes-model.mjs node --import tsx scripts/evaluate-hermes-docker.ts",
    "evaluate:provider:docker": "node --import tsx scripts/evaluate-hermes-docker.ts",
    "evaluate:one-agent": "node --import tsx scripts/evaluate-agent-qualification.ts --mode corpus",
    "evaluate:ten-agent": "node --import tsx scripts/evaluate-concurrency.ts",
    "benchmark:kernel": "node scripts/benchmark-kernel.mjs",
    "test:hermes": "node scripts/with-hermes-model.mjs node node_modules/vitest/vitest.mjs run test/hermes-provider.live.test.ts",
    "with:hermes": "node scripts/with-hermes-model.mjs",
    "harness:hermes": "node scripts/with-hermes-model.mjs node --import tsx apps/launcher/src/main.ts",
    "test": "vitest run",
    "test:approvals": "node scripts/check-approvals.mjs",
    "test:backpressure": "node scripts/check-backpressure.mjs",
    "test:browser": "node scripts/check-browser.mjs",
    "test:context": "node scripts/check-context-optimization.mjs",
    "test:docker": "node scripts/check-docker.mjs",
    "test:real-runtime": "node scripts/check-real-runtime.mjs",
    "test:workspace-lifecycle": "node scripts/check-workspace-lifecycle.mjs",
    "test:run-snapshot": "node scripts/check-run-snapshot.mjs",
    "test:integrations": "node scripts/check-integrations.mjs",
    "test:migrations": "node scripts/check-migrations.mjs",
    "test:optional-systems": "node scripts/check-optional-systems.mjs",
    "test:plugins": "node scripts/check-plugins.mjs",
    "test:providers": "node scripts/check-providers.mjs",
    "test:readiness": "node scripts/check-readiness.mjs",
    "test:replay": "node scripts/check-replay.mjs",
    "test:recovery": "node scripts/check-recovery.mjs",
    "test:unit": "node scripts/run-test-surface.mjs unit",
    "test:contracts": "node scripts/run-test-surface.mjs contracts",
    "test:ipc": "node scripts/run-test-surface.mjs ipc",
    "test:sdk": "node scripts/run-test-surface.mjs sdk",
    "test:skills": "node scripts/run-test-surface.mjs skills",
    "test:mcp": "node scripts/run-test-surface.mjs mcp",
    "test:automation": "node scripts/run-test-surface.mjs automation",
    "test:subagents": "node scripts/run-test-surface.mjs subagents",
    "test:security": "node scripts/run-test-surface.mjs security",
    "test:chaos": "node scripts/run-test-surface.mjs chaos",
    "test:install": "pnpm build:all && pnpm check:artifacts --python-wheel",
    "test:performance": "pnpm benchmark:kernel",
    "test:release": "pnpm verify && pnpm check:release",
    "test:watch": "vitest",
    "dev:manager": "tsx apps/manager/src/main.ts",
    "dev:gateway": "tsx apps/gateway/src/main.ts",
    "dev:launcher": "tsx apps/launcher/src/main.ts",
    "lite": "tsx apps/cli/src/main.ts"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.27.7",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  },
  "optionalDependencies": {
    "pxpipe-proxy": "0.8.0"
  },
  "dependencies": {
    "fastify": "5.8.5"
  }
}
